{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nick-parcel/parcel-skills/schemas/marketplace.schema.json",
  "title": "Claude Code plugin marketplace manifest (marketplace.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "plugins"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pluginRoot": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "allowCrossMarketplaceDependenciesOn": {
      "type": "array",
      "items": { "type": "string" }
    },
    "renames": { "type": "object" },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/pluginEntry" }
    }
  },
  "$defs": {
    "pluginEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string" },
        "source": {
          "type": "string",
          "pattern": "^\\./[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
          "not": { "pattern": "\\.\\." }
        },
        "displayName": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "object" },
        "homepage": { "type": "string" },
        "repository": { "type": "string" },
        "license": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object" },
        "strict": { "type": "boolean" },
        "relevance": { "type": "number" },
        "defaultEnabled": { "type": "boolean" }
      }
    }
  }
}
